# GitVerse environment
# Copy to .env and fill in what you use. The app runs without any of these
# (public GitHub dashboard in preview mode), but features need:

# --- Sessions / sign-in -------------------------------------------------
# Signs the session cookie. Required for sign-in. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# GitHub OAuth app credentials (https://github.com/settings/developers).
# OAuth app callback URL: http://localhost:3000/api/auth/github/callback
# (or your deployed origin + /api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database (persists users + monitoring preferences) ------------------
# MySQL connection string. Without it the app still works, but sign-in
# persistence and monitored-repo preferences are disabled.
DATABASE_URL=

# --- Optional: GitHub API token (higher rate limits for public API calls) --
GITHUB_TOKEN=

# --- Legacy platform values (only needed if running inside the original
# platform environment; safe to leave blank on a self-hosted clone) ---------
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
